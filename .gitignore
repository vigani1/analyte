/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Secrets and local settings
.env
.env.*
*.local.toml

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python bytecode from CI helper scripts
__pycache__/
*.pyc
