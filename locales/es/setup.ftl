setup-error-keys-not-stored = la configuración se guardó, pero las claves no se guardaron: { $value }

setup-error-in-use = el equipo { $value } está usando esta conexión; la prueba no puede compartirla con el servicio en funcionamiento

setup-error-nothing-to-listen = una carpeta vigilada no tiene ninguna conexión en la que escuchar

setup-error-listen-state = el estado de la prueba de conexión no está disponible; reinicie el servicio

setup-error-serial-settings = no se pueden usar los ajustes del puerto serie: { $value }

setup-error-join = el paso de configuración se detuvo de forma inesperada: { $value }

setup-error-audit = no se pudo escribir el registro de quién hizo este cambio: { $value }

setup-error-invalid-name = no se acepta el nombre del equipo: { $value }

setup-error-name-characters = el nombre de un equipo solo usa letras de la A a la Z, dígitos, - y _, porque también da nombre al archivo de configuración del equipo

setup-error-reserved-name = el nombre { $value } lo usa la propia página de configuración; elija otro nombre

setup-error-name-in-use = ya hay un equipo llamado { $value } en la lista; elija otro nombre

setup-error-site-in-use = el archivo de configuración { $value } ya pertenece al equipo { $value-2 }; elija otro nombre

setup-error-history-not-confirmed = el nombre de equipo { $value } tiene resultados o historial guardados de un equipo anterior. Si es el mismo analizador, marque «mismo analizador» para añadirlo con ese nombre; para un analizador distinto, elija un nombre nuevo

setup-error-unfinished-work = el equipo { $value } todavía tiene trabajo sin terminar ({ $value-2 }); no se cambió nada. Revíselo en la página de eliminación y pulse «Eliminar de todos modos» para eliminar el equipo igualmente

setup-error-store = No se pudieron leer los datos guardados de Analyte: { $value }

setup-error-busy = un cambio de configuración anterior falló durante la escritura; vuelva a cargar la página y compruebe los archivos

setup-error-not-signed-in = la sesión del navegador no ha iniciado sesión, así que el cambio no identifica a nadie; inicie sesión en esta página

setup-open-deliveries =
    { $count ->
        [one] { $number } resultado o mensaje de orden todavía no aceptado por la aplicación del laboratorio
        [many] { $number } resultados o mensajes de orden todavía no aceptados por la aplicación del laboratorio
       *[other] { $number } resultados o mensajes de orden todavía no aceptados por la aplicación del laboratorio
    }

setup-open-orders =
    { $count ->
        [one] { $number } orden enviada al equipo y sin terminar (enviándose, enviada, aceptada, cancelación solicitada o incierta); una vez eliminado el equipo, nada la atiende, así que concíliela primero con el equipo (página Órdenes de equipo)
        [many] { $number } órdenes enviadas al equipo y sin terminar (enviándose, enviadas, aceptadas, cancelación solicitada o inciertas); una vez eliminado el equipo, nada las atiende, así que concílielas primero con el equipo (página Órdenes de equipo)
       *[other] { $number } órdenes enviadas al equipo y sin terminar (enviándose, enviadas, aceptadas, cancelación solicitada o inciertas); una vez eliminado el equipo, nada las atiende, así que concílielas primero con el equipo (página Órdenes de equipo)
    }

setup-unread-messages =
    { $count ->
        [one] { $number } mensaje recibido todavía sin leer; solo la configuración de este equipo lo lee, en su próximo inicio
        [many] { $number } mensajes recibidos todavía sin leer; solo la configuración de este equipo los lee, en su próximo inicio
       *[other] { $number } mensajes recibidos todavía sin leer; solo la configuración de este equipo los lee, en su próximo inicio
    }

setup-open-review-items =
    { $count ->
        [one] { $number } elemento en espera de revisión vinculado a este equipo (página Requiere revisión)
        [many] { $number } elementos en espera de revisión vinculados a este equipo (página Requiere revisión)
       *[other] { $number } elementos en espera de revisión vinculados a este equipo (página Requiere revisión)
    }

