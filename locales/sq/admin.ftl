admin-escape-code-not-agreed = Kodi i arratisjes nuk u pajtua

admin-processing-mode-unknown = Modaliteti i përpunimit i panjohur

admin-no-results-in-the-message = Asnjë rezultat në mesazh

admin-time-cannot-be-read = Koha nuk mund të lexohet

admin-incomplete-astm-report = Raport ASTM jo i plotë

admin-the-analyzer-did-not-report-normal-completion = Analizatori nuk raportoi përfundimin normal.

admin-final-status-cannot-be-sent = Statusi përfundimtar nuk mund të dërgohet

admin-this-machine-sends-no-run-number-that-stays-the = Kjo pajisje nuk dërgon asnjë numër ekzekutimi që mbetet i njëjtë dhe kodi i tij i pacientit nuk është një mostër e besuar ID, kështu që Analyte nuk mund ta dallojë këtë rezultat nga të tjerët.

admin-result-identity-repeated = Identiteti i rezultatit përsëritet

admin-two-results-in-this-message-would-have-the-same = Dy rezultate në këtë mesazh do të kishin të njëjtin identitet dhe asnjë nën-ID nuk i dallon ato.

admin-the-device-time-or-sequence-number-that-this-machine = Mungon pajisja, koha ose numri i sekuencës që përdorin cilësimet e kësaj pajisjeje për të dalluar rezultatet.

admin-result-identity-not-trusted = Identiteti i rezultatit nuk është i besueshëm

admin-this-machine-s-sequence-numbers-can-start-over-so = Numrat e sekuencës së kësaj pajisjeje mund të fillojnë nga e para, kështu që ata nuk mund të dallojnë rezultatet pa një ekzekutim dhe rishikim të besueshëm.

admin-this-machine-s-messages-carry-no-trusted-result-or = Mesazhet e kësaj pajisjeje nuk kanë asnjë rezultat të besueshëm ose identitet të ekzekutimit dhe nuk thonë nëse një rezultat është një pacient apo një rezultat i kontrollit të cilësisë.

admin-processing-again-produced-no-results = Përpunimi përsëri nuk dha rezultate

admin-result-differs-from-an-earlier-one = Rezultati ndryshon nga ai i mëparshmi

admin-a-result-came-with-other-content-under-the-same = Një rezultat erdhi me përmbajtje të tjera me të njëjtin identitet si një rezultat i mëparshëm dhe asgjë nuk e shënon atë si korrigjim.

admin-the-message-does-not-give-this-result-an-identity = Mesazhi nuk i jep këtij rezultati një identitet, kështu që Analyte nuk mund të tregojë nëse është i ri, i përsëritur apo një korrigjim.

admin-the-delivery-was-stored-for-a-lab-app-contract = Dorëzimi u ruajt për një version të kontratës së aplikacionit të laboratorit që ky version i Analyte nuk mund ta dërgojë.

admin-the-lab-app-answered-that-it-took-the-delivery = Aplikacioni i laboratorit u përgjigj se mori dorëzimin, por përgjigja e tij nuk ndjek kontratën e aplikacionit të laboratorit, kështu që Analyte nuk e llogarit atë si të dorëzuar.

admin-the-lab-app-refused-the-delivery-but-its-answer = Aplikacioni i laboratorit refuzoi dorëzimin, por përgjigja e tij nuk ndjek kontratën e aplikacionit të laboratorit, kështu që arsyeja e tij nuk dihet.

admin-the-lab-app-gave-an-answer-that-the-lab = Aplikacioni i laboratorit dha një përgjigje që kontrata e aplikacionit të laboratorit nuk e përcakton për një dërgesë.

admin-older-order-version-refused = Versioni i vjetër i porosisë u refuzua

admin-changed-order-refused = Urdhri i ndryshuar u refuzua

admin-error-awos-item-not-retained = Artikulli AWOS nuk u ruajt

admin-error-session-capacity = kapaciteti i seancës së administratorit është arritur; rinisni ose prisni për skadimin

admin-error-admin-session-lock-poisoned = bllokimi i seancës së administratorit u helmua

admin-error-choose-place-or-release = zgjidhni vendin ose lirimin

admin-error-choose-receipt-or-order = zgjidhni faturën ose porosinë

admin-error-store-mismatch = konfigurimi aktual tregon në një depo të dhënash tjetër

admin-error-machine-cursor-overflow = tejmbushje e kursorit të pajisjes

admin-error-no-software-check = kjo pajisje nuk ka kontroll të versionit të softuerit

admin-error-no-software-warning = kjo pajisje nuk ka asnjë paralajmërim aktiv të softuerit

admin-error-parked-target-cursor-overflow = tejkalim i kursorit të synuar të parkuar

admin-waiting-after-restart = "Pritja" është normale pas një rifillimi

admin-count-recorded-messages =
    { $count ->
        [one] { $number } mesazh
       *[other] { $number } mesazhe
    }

admin-count-failed-exchanges =
    { $count ->
        [one] { $number } shkëmbim i dështuar
       *[other] { $number } shkëmbime të dështuara
    }

admin-count-machine-problems =
    { $count ->
        [one] { $number } problem
       *[other] { $number } probleme
    }

admin-count-machines-waiting =
    { $count ->
        [one] { $number } në pritje të pajisjes
       *[other] { $number } në pritje të pajisjeve
    }

admin-count-machines-awaiting-setup =
    { $count ->
        [one] { $number } ende e pakonfiguruar
       *[other] { $number } ende të pakonfiguruara
    }

admin-count-machines-start-on-restart =
    { $count ->
        [one] { $number } nis pas rinisjes
       *[other] { $number } nisin pas rinisjes
    }

admin-count-machines-stop-on-restart =
    { $count ->
        [one] { $number } e hequr, ndalon pas rinisjes
       *[other] { $number } të hequra, ndalojnë pas rinisjes
    }

admin-count-new-results =
    { $count ->
        [one] { $number } rezultat i ri
       *[other] { $number } rezultate të reja
    }

admin-count-corrections =
    { $count ->
        [one] { $number } korrigjim
       *[other] { $number } korrigjime
    }

admin-count-already-received =
    { $count ->
        [one] { $number } rezultat i marrë më parë
       *[other] { $number } rezultate të marra më parë
    }

admin-count-conflicts =
    { $count ->
        [one] { $number } rezultat në konflikt, i mbajtur për shqyrtim
       *[other] { $number } rezultate në konflikt, të mbajtura për shqyrtim
    }

admin-count-unresolved =
    { $count ->
        [one] { $number } rezultat pa identitet, i mbajtur për shqyrtim
       *[other] { $number } rezultate pa identitet, të mbajtura për shqyrtim
    }

admin-count-waiting-items =
    { $count ->
        [one] { $number } çështje në pritje
       *[other] { $number } çështje në pritje
    }

admin-kept-item-agreement =
    { $count ->
        [one] është
       *[other] janë
    }

admin-retained-deliveries =
    { $status ->
        [missing-keys] { admin-cannot-send-to-lab-app-its-api-key-or }
        [not-configured] { admin-cannot-send-to-lab-app-it-is-not-set }
        [delivering] { admin-still-being-delivered-to-lab-app }
       *[waiting] { admin-wait-for-lab-app-they-are-sent-after-the }
    }

admin-message-holds-no-results = Mesazhi nuk ka rezultate.

admin-identity-missing = Identiteti i rezultatit mungon

admin-message-cut-off = Mesazhi u ndërpre

admin-report-reload = Rifresko faqen; nëse kjo vazhdon të ndodhë, jepni detajet më poshtë për të mbështetur.

admin-report-reload-after = { $reason } { admin-report-reload }
